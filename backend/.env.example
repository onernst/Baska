# Server Configuration
PORT=3000
NODE_ENV=development

# Security
# For testing: default secret is used if not set
# For production: MUST set a secure random secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-characters

# CORS Origins (comma-separated)
# For testing: allows all origins when NODE_ENV=development
# For production: set to your actual frontend domains
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (SQLite file path - relative to server.js)
# DB_PATH=./baska.db
